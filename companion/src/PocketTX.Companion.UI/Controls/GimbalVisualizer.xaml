<UserControl x:Class="PocketTX.Companion.UI.Controls.GimbalVisualizer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="200">
    
    <Border Background="{DynamicResource CardHeaderBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="2"
            CornerRadius="12"
            Padding="8">
        <Grid x:Name="ContainerGrid" 
              Background="Transparent"
              Cursor="Hand"
              ClipToBounds="True"
              MouseDown="ContainerGrid_MouseDown"
              MouseMove="ContainerGrid_MouseMove"
              MouseUp="ContainerGrid_MouseUp"
              MouseLeave="ContainerGrid_MouseLeave">
            
            <!-- Concentric Guide Rings -->
            <Ellipse Width="140" Height="140" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeDashArray="2 2" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
            <Ellipse Width="80" Height="80" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeDashArray="2 2" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>

            <!-- Crosshair Grid Lines -->
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Height="1" VerticalAlignment="Center" Opacity="0.7"/>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Width="1" HorizontalAlignment="Center" Opacity="0.7"/>

            <!-- Center Neutral Circle -->
            <Ellipse Width="16" Height="16" Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>

            <!-- Dynamic Stick Vector Trail Line -->
            <Canvas>
                <Line x:Name="StickVectorLine"
                      Stroke="{DynamicResource PrimaryAccentBrush}"
                      StrokeThickness="1.5"
                      Opacity="0.5"
                      StrokeDashArray="2 1"/>

                <!-- Gimbal Stick Dot -->
                <Ellipse x:Name="StickDot"
                         Width="20" Height="20"
                         Fill="{DynamicResource PrimaryAccentBrush}"
                         Stroke="#FFFFFF"
                         StrokeThickness="2.5">
                    <Ellipse.Effect>
                        <DropShadowEffect x:Name="DotGlow" Color="#5B8DEF" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
            
            <!-- Title Header -->
            <TextBlock x:Name="TitleLabel" Text="GIMBAL"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="10" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"/>

            <!-- Live Position Indicator Badge -->
            <Border x:Name="PosBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                    Background="#1F2A3E" CornerRadius="4" Padding="4,2">
                <TextBlock x:Name="PosText" Text="0, 0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" FontFamily="Consolas"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
