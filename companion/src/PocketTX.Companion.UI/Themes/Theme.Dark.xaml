<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Accent Palette -->
    <Color x:Key="PrimaryAccentColor">#5B8DEF</Color>
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}" />
    
    <Color x:Key="PrimaryAccentHoverColor">#4A7BDC</Color>
    <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="{StaticResource PrimaryAccentHoverColor}" />

    <!-- Dark Theme Backgrounds -->
    <Color x:Key="WindowBackgroundColor">#0F1218</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />

    <Color x:Key="SidebarBackgroundColor">#141822</Color>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />

    <Color x:Key="CardBackgroundColor">#1B202E</Color>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />

    <Color x:Key="CardHeaderBackgroundColor">#22293A</Color>
    <SolidColorBrush x:Key="CardHeaderBackgroundBrush" Color="{StaticResource CardHeaderBackgroundColor}" />

    <Color x:Key="BorderColor">#2A3246</Color>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}" />

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F4FC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8C9BB4" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5A6882" />

    <!-- Badge Brushes -->
    <SolidColorBrush x:Key="SuccessBadgeBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="WarningBadgeBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="ErrorBadgeBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="InfoBadgeBrush" Color="#3B82F6" />

</ResourceDictionary>
