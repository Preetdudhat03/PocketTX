<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Accent Palette -->
    <Color x:Key="PrimaryAccentColor">#5B8DEF</Color>
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}" />
    
    <Color x:Key="PrimaryAccentHoverColor">#4A7BDC</Color>
    <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="{StaticResource PrimaryAccentHoverColor}" />

    <!-- Light Theme Backgrounds -->
    <Color x:Key="WindowBackgroundColor">#F8FAFC</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />

    <Color x:Key="SidebarBackgroundColor">#F1F5F9</Color>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />

    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />

    <Color x:Key="CardHeaderBackgroundColor">#E2E8F0</Color>
    <SolidColorBrush x:Key="CardHeaderBackgroundBrush" Color="{StaticResource CardHeaderBackgroundColor}" />

    <Color x:Key="BorderColor">#CBD5E1</Color>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}" />

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />

    <!-- Badge Brushes -->
    <SolidColorBrush x:Key="SuccessBadgeBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="WarningBadgeBrush" Color="#D97706" />
    <SolidColorBrush x:Key="ErrorBadgeBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="InfoBadgeBrush" Color="#2563EB" />

</ResourceDictionary>
