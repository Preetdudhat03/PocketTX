<Window x:Class="PocketTX.Companion.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PocketTX.Companion.UI.ViewModels"
        xmlns:views="clr-namespace:PocketTX.Companion.UI.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="PocketTX Companion" Height="750" Width="1200"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0F1218">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TestControllerViewModel}">
            <views:TestControllerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
            <views:DiagnosticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
            <views:ProfilesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#0F1218">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="#141822" BorderBrush="#2A3246" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,24">
                <!-- App Header Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,32">
                    <TextBlock Text="POCKET TX" Foreground="#5B8DEF" FontSize="22" FontWeight="Black"/>
                    <TextBlock Text="COMPANION v1.0" Foreground="#8C9BB4" FontSize="11" FontWeight="Bold" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Navigation Buttons -->
                <StackPanel DockPanel.Dock="Top">
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Content="DASHBOARD" Padding="16,12" HorizontalContentAlignment="Left" Background="#1B202E" Foreground="#F0F4FC" BorderThickness="0" FontSize="13" FontWeight="Bold" Margin="0,3"/>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="TestController" Content="TEST CONTROLLER" Padding="16,12" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#F0F4FC" BorderThickness="0" FontSize="13" FontWeight="Bold" Margin="0,3"/>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Diagnostics" Content="DIAGNOSTICS" Padding="16,12" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#F0F4FC" BorderThickness="0" FontSize="13" FontWeight="Bold" Margin="0,3"/>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Profiles" Content="PROFILES" Padding="16,12" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#F0F4FC" BorderThickness="0" FontSize="13" FontWeight="Bold" Margin="0,3"/>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Settings" Content="SETTINGS" Padding="16,12" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#F0F4FC" BorderThickness="0" FontSize="13" FontWeight="Bold" Margin="0,3"/>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Logs" Content="LOG TERMINAL" Padding="16,12" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#F0F4FC" BorderThickness="0" FontSize="13" FontWeight="Bold" Margin="0,3"/>
                </StackPanel>

                <!-- Footer Status -->
                <Border DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Background="#1B202E" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="STATUS" Foreground="#8C9BB4" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Simulating RC Input" Foreground="#5B8DEF" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Right Main View Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Shell Bar -->
            <Border Grid.Row="0" Background="#141822" BorderBrush="#2A3246" BorderThickness="0,0,0,1" Padding="24,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActiveViewTitle}" Foreground="#F0F4FC" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>

                    <!-- Connection Badge -->
                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#22C55E" CornerRadius="12" Padding="12,4" VerticalAlignment="Center">
                        <TextBlock Text="TEST MODE (SIMULATION)" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Active View Host -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>
