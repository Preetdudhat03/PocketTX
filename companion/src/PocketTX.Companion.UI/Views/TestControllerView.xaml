<UserControl x:Class="PocketTX.Companion.UI.Views.TestControllerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PocketTX.Companion.UI.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            
            <!-- Top Header & Action Buttons -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="TEST CONTROLLER MODE" Foreground="{DynamicResource PrimaryAccentBrush}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Simulate live RC stick inputs and aux switches directly into Windows" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Quick Action Buttons -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleArmCommand}" Margin="4,0" Padding="16,8" Background="{DynamicResource CardHeaderBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ARM: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding IsArmed}" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ToggleBeeperCommand}" Margin="4,0" Padding="16,8" Background="{DynamicResource CardHeaderBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="BEEPER: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding IsBeeperActive}" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CycleFlightModeCommand}" Margin="4,0" Padding="16,8" Background="{DynamicResource CardHeaderBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MODE: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding FlightModeText}" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ResetSticksCommand}" Margin="4,0" Padding="16,8" Background="{DynamicResource CardHeaderBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="RESET CENTER" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Real-Time Telemetry & Latency Test Bar -->
            <Border Background="{DynamicResource CardHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Real-Time Latency -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⚡ LATENCY: " Foreground="{DynamicResource TextMutedBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LatencyMs, StringFormat='{}{0:F1} ms'}" Foreground="{DynamicResource PrimaryAccentBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Packet Rate -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="📡 PACKET RATE: " Foreground="{DynamicResource TextMutedBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PacketRate, StringFormat='{}{0} Hz'}" Foreground="#22C55E" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Connection Status -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🔌 STATUS: " Foreground="{DynamicResource TextMutedBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConnectionStatusText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dual Gimbals Section (Interactive RadioMaster Style Visualizer) -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="💡 Click &amp; drag the stick dots to test stick response, or move your phone joysticks in real-time!"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" System.Windows.Controls.TextBlock.TextAlignment="Center" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Stick (Throttle Y, Yaw X) -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="LEFT STICK (THROTTLE / YAW)" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <controls:GimbalVisualizer XValue="{Binding YawNormalized, Mode=TwoWay}" YValue="{Binding ThrottleNormalized, Mode=TwoWay}" DefaultYValue="-1.0" Title="THROTTLE / YAW" Width="220" Height="220"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <TextBlock Text="Throttle: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding ThrottlePwm, StringFormat='{}{0}us'}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" Margin="0,0,16,0"/>
                                <TextBlock Text="Yaw: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding YawPwm, StringFormat='{}{0}us'}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right Stick (Pitch Y, Roll X) -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="RIGHT STICK (PITCH / ROLL)" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <controls:GimbalVisualizer XValue="{Binding RollNormalized, Mode=TwoWay}" YValue="{Binding PitchNormalized, Mode=TwoWay}" DefaultYValue="0.0" Title="PITCH / ROLL" Width="220" Height="220"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <TextBlock Text="Pitch: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding PitchPwm, StringFormat='{}{0}us'}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" Margin="0,0,16,0"/>
                                <TextBlock Text="Roll: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding RollPwm, StringFormat='{}{0}us'}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Axis Sliders Section -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="ANALOG AXIS SLIDERS" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,16"/>

                    <!-- Roll -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Roll (Aileron)" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="-1.0" Maximum="1.0" Value="{Binding RollNormalized, Mode=TwoWay}" SmallChange="0.05" LargeChange="0.2" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding RollPwm, StringFormat='{}{0} us'}" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Pitch -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pitch (Elevator)" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="-1.0" Maximum="1.0" Value="{Binding PitchNormalized, Mode=TwoWay}" SmallChange="0.05" LargeChange="0.2" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding PitchPwm, StringFormat='{}{0} us'}" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Throttle -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Throttle" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="-1.0" Maximum="1.0" Value="{Binding ThrottleNormalized, Mode=TwoWay}" SmallChange="0.05" LargeChange="0.2" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding ThrottlePwm, StringFormat='{}{0} us'}" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Yaw -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Yaw (Rudder)" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="-1.0" Maximum="1.0" Value="{Binding YawNormalized, Mode=TwoWay}" SmallChange="0.05" LargeChange="0.2" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding YawPwm, StringFormat='{}{0} us'}" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
